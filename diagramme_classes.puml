@startuml

skinparam Shadowing false               /' Désactive l'effet d'ombre sur les éléments '/
skinparam classAttributeIconSize 0      /' Taille des icônes d'attribut de classe (ici 0 pour les cacher) '/
skinparam defaultFontName Consolas      /' Utilisation de la police Consolas par défaut '/
!pragma useIntermediatePackages false   /' Désactive l'utilisation de packages intermédiaires '/


class Program {
     - ActionList
     + up(Action) : void
     + down(Action) : void
     + duplicate(Action) : Action
     + delete(Action) : Action
     + deleteAll() : void
}

class ActionList{
    - List<Action>
    + add(Action) : boolean
}


class Catalogue {
    - ActionList
    + addToCatalogue() : boolean
    + addToProgram() : boolean
}

abstract class Action {
    - nom : String
    - value : double
    + execute(Scene) : void
    + create_default() : Action
    + copy() : Action
}

class Move_Forward {
}

abstract class Turn {
}

class Turn_Right {
}

class Turn_Left {
}

abstract class Pen {

}

class Pen_Up {
}

class Pen_Down {
}


class Scene {
    - cursor : Cursor
    - lineList
    + repaint() : void
    + suivant() : void
    + charger() : void
    + reinitialiser() : void
}

class Cursor {
    - origine: Point
    - direction = 90 : double
    - writing=true : boolean
}

class LineList {
    - List<MyLine>
    + add(Line) : boolean
}

class MyLine {
    - origine : Point
    - arrivee : Point
}

class Point {
    - x : double
    - y : double
    + translate(double dx, double dy) : Point
}


Move_Forward --|> Action : is
Turn --|> Action : is
Turn_Right --|> Turn : is
Turn_Left --|> Turn : is
Pen --|> Action : is
Pen_Up --|> Pen : is
Pen_Down --|> Pen : is


Action --> Scene : > modifies
Program "1"*--"1" ActionList
ActionList "1"*--"many" Action : > contains
Catalogue "1"o--"many" Action : > has
Catalogue *-- ActionList

Scene "1"*--"1" Cursor : > contains
Scene "1"*--"1" LineList : > has
LineList "1"*--"many" MyLine : > contains
Cursor "1"*--"1" Point : > has
MyLine "1"*--"2" Point : > contains

Scene "1"-->"1" Program : > gets modified by Actions from

Program --> Catalogue : >  gets Actions from


@enduml
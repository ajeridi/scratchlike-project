@startuml

skinparam Shadowing false               /' Désactive l'effet d'ombre sur les éléments '/
skinparam classAttributeIconSize 0      /' Taille des icônes d'attribut de classe (ici 0 pour les cacher) '/
skinparam defaultFontName Consolas      /' Utilisation de la police Consolas par défaut '/
!pragma useIntermediatePackages false   /' Désactive l'utilisation de packages intermédiaires '/


class Program {
     - ActionList
     + up(Action) : void
     + down(Action) : void
     + duplicate(Action) : Action
     + delete(Action) : Action
     + deleteAll() : void
}

class ActionList{
    - List<Action>
    + add(Action) : boolean
}


class Catalogue {
    - ActionList
    + addToCatalogue() : boolean
    + addToProgram() : boolean
}

abstract class Action {
    - nom : String
    - variable : Variable
    + execute(Scene) : void
    + create_default() : Action
    + copy() : Action
    + convertValueOrVariableToDouble(String) : double
}

interface Variable {
    + getValue() : double
}

class Entière {
    - var_name : String
}

class Litterale{
    - value : double
}


class Move_Forward {
}

abstract class Turn {
}

class Turn_Right {
}

class Turn_Left {
}

abstract class Pen {

}

class Pen_Up {
}

class Pen_Down {
}

abstract class Action_On_Var {
    - var_name
}
class Var_Declaration {
    /'declare une variable'/
    - var_name : String
}

class Var_Assignment {
    /'Assigne une variable'/
    - var_target : String
}

class Inc_Dec_Variable {
    /'Incrémente ou décrémente la variable'/
    - var_target : String
}

class Repeat {
    - List<Action>
}

class End_Repeat{
}

class Variable_Table {
    - table : Map<String, double>
    + getValue(String) : double
}

class Scene {
    - cursor : Cursor
    - lineList
    - variables : Map<String, double>  /'une map de variables, chaque clé est le nom de la variable et la valeur est la valeur de la variable, à voir si utile dans scene ou pas'/
    + nextAction() : void
    + createLine(Point) : void
    + load() : void
    + reset() : void
}

class Cursor {
    - origine: Point
    - direction = 90 : double
    - writing=true : boolean
}

class LineList {
    - List<MyLine>
    + add(Line) : boolean
}

class MyLine {
    - origine : Point
    - arrivee : Point
}

class Point {
    - x : double
    - y : double
    + translate(double dx, double dy) : Point
}


Move_Forward --|> Action : is
Turn --|> Action : is
Turn_Right --|> Turn : is
Turn_Left --|> Turn : is
Pen --|> Action : is
Pen_Up --|> Pen : is
Pen_Down --|> Pen : is
Action_On_Var --|> Action : is
Var_Declaration --|> Action_On_Var : is
Var_Assignment --|> Action_On_Var : is
Inc_Dec_Variable --|> Action_On_Var : is
Repeat --|> Action : is
End_Repeat --|> Action : is


Action --> Scene : > modifies elements in
Program "1"*--"1" ActionList
ActionList "1"*--"many" Action : > contains
Catalogue "1"o--"many" Action : > has
Catalogue "1"*--"1" ActionList
Action "1"*--"1" Variable
Entière ..|> Variable
Litterale ..|> Variable

Entière --> Variable_Table : > gets value from

Scene "1"*--"1" Cursor : > contains
Scene "1"*--"1" LineList : > has
LineList "1"*--"many" MyLine : > contains
Cursor "1"*--"1" Point : > has
MyLine "1"*--"2" Point : > contains

Scene "1"-->"1" Program : > gets modified by Actions from

Program --> Catalogue : >  gets Actions from


@enduml
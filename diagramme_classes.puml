@startuml

skinparam Shadowing false               /' Désactive l'effet d'ombre sur les éléments '/
skinparam classAttributeIconSize 0      /' Taille des icônes d'attribut de classe (ici 0 pour les cacher) '/
skinparam defaultFontName Consolas      /' Utilisation de la police Consolas par défaut '/
!pragma useIntermediatePackages false   /' Désactive l'utilisation de packages intermédiaires '/


class Program {
     - ActionList
     + up(Action) : void
     + down(Action) : void
     + duplicate(Action) : Action
     + delete(Action) : Action
     + deleteAll() : void
}

class ActionList{
    - List<Action>
    + add(Action) : boolean
}


class Catalogue {
    - ActionList
    + addToCatalogue() : boolean
    + addToProgram() : boolean
}

class ActionFactory {
    + mapStringToAction(String line) : Action
    +  mapActionsToString(ActionList actions) : List<String>
}

abstract class Action {
    - nom : String
    - variable : Variable
    + execute(Runtime) : void
    + create_default() : Action
    + copy() : Action
    + convertValueOrVariableToDouble(String) : double
}

class Variable {
    - name : String
    - value : double
}

class Move_Forward {
}

abstract class Turn {
}

class Turn_Right {
}

class Turn_Left {
}

abstract class Pen {

}

class Pen_Up {
}

class Pen_Down {
}

abstract class Action_On_Var {
    - var_name
}
class Var_Declaration {
    /'declare une variable'/
}

class Var_Assignment {
    /'Assigne une variable'/
}

class Inc_Dec_Variable {
    /'Incrémente ou décrémente la variable'/
}

class Repeat {
    - List<Action>
}

class End_Repeat{
}

class VariableTable {
    - table : Map<String, Variable>
}

class Runtime {
    - Scene
    - VariableTable
    + nextAction() : void
    + load() : void
    + reset() : void
}

class Scene {
    - cursor : Cursor
    - lineList
    + createLine(Point) : void
}

class Cursor {
    - origine: Point
    - direction = 90 : double
    - writing=true : boolean
}

class LineList {
    - List<MyLine>
    + add(Line) : boolean
}

class MyLine {
    - origine : Point
    - arrivee : Point
}

class Point {
    - x : double
    - y : double
    + translate(double dx, double dy) : Point
}


Move_Forward --|> Action : is
Turn --|> Action : is
Turn_Right --|> Turn : is
Turn_Left --|> Turn : is
Pen --|> Action : is
Pen_Up --|> Pen : is
Pen_Down --|> Pen : is
Action_On_Var --|> Action : is
Var_Declaration --|> Action_On_Var : is
Var_Assignment --|> Action_On_Var : is
Inc_Dec_Variable --|> Action_On_Var : is
Repeat --|> Action : is
End_Repeat --|> Action : is

ActionFactory --> ActionList : > converts Actions to File
Action --> Runtime : > Executes on
Program "1"*--"1" ActionList
ActionList "1"*--"*" Action : > contains
Catalogue "1"*--"1" ActionList
Action "1"*--"1" Variable : > has

VariableTable "1"*--"*" Variable : > contains

Runtime "1"*--"1" Scene : > contains
Runtime "1"*--"1" VariableTable : > contains

Scene "1"*--"1" Cursor : > contains
Scene "1"*--"1" LineList : > has
LineList "1"*--"*" MyLine : > contains
Cursor "1"*--"1" Point : > has
MyLine "1"*--"2" Point : > contains

Runtime "1"-->"1" Program : > gets modified by Actions from

Program --> Catalogue : >  gets Actions from


@enduml
@startuml

skinparam Shadowing false               /' Désactive l'effet d'ombre sur les éléments '/
skinparam classAttributeIconSize 0      /' Taille des icônes d'attribut de classe (ici 0 pour les cacher) '/
skinparam defaultFontName Consolas      /' Utilisation de la police Consolas par défaut '/
!pragma useIntermediatePackages false   /' Désactive l'utilisation de packages intermédiaires '/

abstract class scratch.model.actions.Action {
    - nom : String
    - variable : Variable
    - color : String
    - loopDepth : int
    - hasError : boolean
    + {abstract} execute(ExecutionState) : void
    + {abstract} create_default() : Action
    + {abstract} isValidValue(double) : boolean
    + {abstract} copy() : Action
    + {abstract} getType() : String
}

scratch.model.actions.Action ..> scratch.model.ExecutionState : executes on >
scratch.model.actions.Action *-- scratch.model.Variable : has >

class scratch.model.actions.End_Repeat{
}

scratch.model.actions.End_Repeat --|> scratch.model.actions.Action

class scratch.model.actions.Increment_Variable{
}

scratch.model.actions.Increment_Variable --|> scratch.model.actions.Target_Action

class scratch.model.actions.Move_Forward {
}

scratch.model.actions.Move_Forward --|> scratch.model.actions.Action


abstract class scratch.model.actions.Pen {
    + {abstract} movePen() : void
}
scratch.model.actions.Pen --|> scratch.model.actions.Action


class scratch.model.actions.Pen_Down {

}

scratch.model.actions.Pen_Down --|> scratch.model.actions.Pen


class scratch.model.actions.Pen_Up {

}

scratch.model.actions.Pen_Up --|> scratch.model.actions.Pen

class scratch.model.actions.Repeat{
}

scratch.model.actions.Repeat --|> scratch.model.actions.Action

abstract class scratch.model.actions.Target_Action{
    - target_name : SimpleStringProperty
}
scratch.model.actions.Target_Action --|> scratch.model.actions.Action

abstract class scratch.model.actions.Turn {
    + turnCursor(Cursor) : void
}

scratch.model.actions.Turn --|> scratch.model.actions.Action

class scratch.model.actions.Turn_Left {

}
scratch.model.actions.Turn_Left --|> scratch.model.actions.Turn

class scratch.model.actions.Turn_Right {
}

scratch.model.actions.Turn_Right --|> scratch.model.actions.Turn

class scratch.model.actions.Var_Assignment {
}

scratch.model.actions.Var_Assignment --|> scratch.model.actions.Target_Action


class scratch.model.actions.Var_Declaration {
}

scratch.model.actions.Var_Declaration --|> scratch.model.actions.Action


class scratch.model.ActionFactory {
     + mapStringToAction(String line) : Action
     + mapActionsToString(ActionList actions) : List<String>
}

class scratch.model.ActionList {
    - actions : ObservableList<Action>
    + add(Action) : boolean
    + getSizeProperty() : IntegerBinding
    + isEmptyProperty() : BooleanBinding
    + swap(int, int) : void
    + delete(Action) : void
    + deleteAll() : void
}

class scratch.model.Catalogue {
    - catalogue : ActionList
    + add(Action) : boolean
    + getCatalogue() : ObservableList<Action>
}

scratch.model.Catalogue *-- scratch.model.ActionList : has >

class scratch.model.Cursor {
    - origine : Point
    - direction : double
    - writing : boolean
    + reset() : void
}

scratch.model.Cursor *-- scratch.model.Point : has >

class scratch.model.ExecutionState {
    - scene : Scene
    - currentIndex : Stack<Integer>
    - loopActions : Stack<Action>
    - loopCounters : Stack<Integer>
    + reset() : void
}

scratch.model.ExecutionState *-- scratch.model.Scene : has >

class scratch.model.LineList {
    - lines : List<MyLine>
    + add(MyLine) : boolean
    + clear() : void
}

scratch.model.LineList *-- scratch.model.MyLine : has >

class scratch.model.MyLine {

}


class scratch.model.Point {
    - x : double
    - y : double
    + translate(double, double) : Point
}

class scratch.model.Program {
    - actionList : ActionList
    - loops : Stack<ActionList>
    - isValidProgram : BooleanProperty
    - compileProgram() : boolean
    + getSizeProperty() : IntegerBinding
    + actionIsEmptyProperty() : BooleanBinding
    + addActionToList(Action action) : boolean
    + up(int) : void
    + down(int) : void
    + duplicate(Action) : void
    + delete(Action) : void
    + deleteAll()
    + open(File) : void
    + saveFile(File) void
}

scratch.model.Program *-- scratch.model.ActionList : has >
scratch.model.Program ..> scratch.model.ActionFactory : uses >

class scratch.model.Scene {
    - cursor : Cursor
    - lines ; LineList
    + createLine(Point) : void
    + reset() : void
}

scratch.model.Scene *-- scratch.model.Cursor : has >
scratch.model.Scene *-- scratch.model.LineList : has >


class scratch.model.Variable {
    - name : SimpleStringProperty
    - value : SimpleDoubleProperty
    + hasName() : boolean
    + getValue() : double
    + validateName(String) : String
}

scratch.model.Variable ..> scratch.model.Variable_Table : gets value from >

class scratch.model.Variable_Table {
    - variables : ObservableMap<String, StringProperty>
    + getValue(String) : double
    + putVariable(String, SimpleStringProperty) : void
}


class scratch.view.CatalogueView {
    - actionListView : ListView<Action>
    - catalogueViewModel : CatalogueViewModel
    - addButton : Button
}

scratch.view.CatalogueView ..> scratch.viewmodel.CatalogueViewModel : uses >

class scratch.view.ExecutionView {
    - loadBtn : Button
    - executeBtn : Button
    - automaticModeCheckBox : CheckBox
    - manualModeCheckBox : CheckBox
    - automaticExecutinoSpeedSlider : Slider
    - stopBtn : Button
}

scratch.view.ExecutionView ..> scratch.viewmodel.ExecutionViewModel : binds to >


class scratch.view.InformationView{
    - cursorInformation : Label
    - variableTable : TableView
}

scratch.view.InformationView ..> scratch.viewmodel.InformationViewModel : binds to >

class scratch.view.MainView {
    - catalogueView : CatalogueView
    - programView : ProgramView
    - sceneView : SceneView
    - executionView : executionView
    - informationView : InformationView
    - mainViewModel : MainViewModel
    - stage : Stage
    - menu : MenuBar
    - fileChooser : FileChooser
}
scratch.view.MainView *-- scratch.view.CatalogueView
scratch.view.MainView *-- scratch.view.ProgramView
scratch.view.MainView *-- scratch.view.SceneView
scratch.view.MainView *-- scratch.view.ExecutionView
scratch.view.MainView *-- scratch.view.InformationView

scratch.view.MainView ..> scratch.viewmodel.MainViewModel : binds to


class scratch.view.ProgramView {
    - actions : ListView<Action>
    - upButton : Button
    - downButton : Button
    - duplicateButton : Button
    - deleteButton : Button
    - deleteAllButton : Button
    - detailActionPane : TitledPane
    - programViewModel : ProgramViewModel
}

scratch.view.ProgramView ..> scratch.viewmodel.ProgramViewModel : binds to >

class scratch.view.SceneView {
    - sceneCanvas : Canvas
    - refreshCounter : IntegerProperty
    - sceneViewModel : SceneViewModel
}
scratch.view.SceneView ..> scratch.viewmodel.SceneViewModel : binds to >

class scratch.viewmodel.CatalogueViewModel {
    - catalogue : Catalogue
    - mainViewModel : mainViewModel
    + addToProgram(Action) : boolean
}

scratch.viewmodel.CatalogueViewModel ..> scratch.model.Catalogue : gets data >
scratch.viewmodel.CatalogueViewModel ..> scratch.viewmodel.MainViewModel : uses >

class scratch.viewmodel.ExecutionViewModel {
    - executionState : ExecutionState
    - mainViewModel : MainViewModel
    - currentActionIndex : IntegerProperty
    - isLoaded : BooleanProperty
    - programChanged : BooleanProperty
    - isExecuted : BooleanProperty
    - isAtLastAction : BooleanProperty
    - isValidProgram : BooleanProperty
    - faultyAction : Action
    - runtimeError : BooleanProperty
    - refreshCounter : IntegerProperty
    + loadProgram() : void
    + resetProgram() : void
    + newProgram() : void
    + executeProgram() : void
    + nextAction() : void
}

scratch.viewmodel.ExecutionViewModel ..> scratch.model.ExecutionState : binds to
scratch.viewmodel.ExecutionViewModel ..> scratch.viewmodel.MainViewModel : binds to

class scratch.viewmodel.InformationViewModel {
    - cursor : Cursor
    - observableListOfMap : ObservableList<Map.Entry<String, StringProperty>>
}

scratch.viewmodel.InformationViewModel ..> scratch.model.Cursor : binds to
scratch.viewmodel.InformationViewModel ..> scratch.model.Variable_Table : gets data from >

class scratch.viewmodel.MainViewModel {
    - catalogueViewModel : CatalogueViewModel
    - programViewModel : ProgramViewModel
    - sceneViewModel : SceneViewModel
    - executionViewModel : ExcutionViewModel
    - informationViewModel : InformationViewModel
    - program : Program
    - refreshCounter : IntegerProperty
    - runtimeError : BooleanProperty
    + addToProgram(Action) : boolean
    + getSelectedIndexProperty() : IntegerProperty
    + getCurrentSelectedActionProperty() : ReadOnlyObjectProperty<Action>
    + getActionsSizeProperty() : IntegerBinding
    + isActionsListEmpty() : BooleanBinding
    + newFile() : void
    + openFile(File) : void
    + saveFile(File) : void
}

scratch.viewmodel.MainViewModel *-- scratch.viewmodel.CatalogueViewModel
scratch.viewmodel.MainViewModel *-- scratch.viewmodel.ProgramViewModel
scratch.viewmodel.MainViewModel *-- scratch.viewmodel.SceneViewModel
scratch.viewmodel.MainViewModel *-- scratch.viewmodel.ExecutionViewModel
scratch.viewmodel.MainViewModel *-- scratch.viewmodel.InformationViewModel

class scratch.viewmodel.ProgramViewModel {
    - program : Program
    - mainViewModel : MainViewModel
    - selectedIndex : IntegerProperty
    - currentSelectedAction : ObjectProperty<Action>
    - isValidValue : BooleanProperty
    - userInput : StringProperty
    + addToActionList(Action) : boolean
    + getActionsSizeProperty() : IntegerBinding
    + actionIsEmptyProperty() : BooleanBinding
    + moveUp(int) : void
    + moveDown(int) : void
    + duplicate(Action) : void
    + deleteAction(Action) : void
    + deleteAllActions() : void
    + newProgram() : void
}

scratch.viewmodel.ProgramViewModel ..> scratch.model.Program : binds to and uses methods in>
scratch.viewmodel.ProgramViewModel ..> scratch.viewmodel.MainViewModel : binds to >

class scratch.viewmodel.SceneViewModel {
    - scene : Scene
    - mainViewModel : MainViewModel
    - refreshCounter : IntegerProperty
}

scratch.viewmodel.SceneViewModel ..> scratch.model.Scene : uses
scratch.viewmodel.SceneViewModel ..> scratch.viewmodel.MainViewModel : binds to >

class scratch.App {
    - catalogue : Catalogue
    - program : Program
    - scene : Scene
    - mainViewModel : MainViewModel
    - mainView : MainView
}

scratch.App *-- scratch.viewmodel.MainViewModel
scratch.App *-- scratch.view.MainView
scratch.App *-- scratch.model.Catalogue
scratch.App *-- scratch.model.Program
scratch.App *-- scratch.model.Scene

@enduml